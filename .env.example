# Copy to .env (gitignored) and fill in. Loaded by harness/app/training scripts.

# Anthropic API (console.anthropic.com -> API keys). Used for: B1 baseline evals,
# chatbot backend serving. NOT the same as a Claude Pro/Max subscription.
ANTHROPIC_API_KEY=

# Prime Intellect (app.primeintellect.ai -> settings -> API keys). Used for: GPU
# pods for T0 smoke test and prime-rl SFT/RL runs.
PRIME_API_KEY=

# Thinking Machines Tinker. Used only by training/tinker_sft.py and
# evals/tinker_sft_scorecard.py. Those entry points read this environment
# variable directly; never commit a populated value.
TINKER_API_KEY=

# Frontier baselines for the benchmark leaderboard — one key, all models
# (GPT/Gemini/Claude/DeepSeek via openrouter.ai). Benchmark comparison only,
# never an SFT teacher (distillation-clause discipline).
OPENROUTER_API_KEY=

# Optional single-provider alternatives.
OPENAI_API_KEY=
GEMINI_API_KEY=

# The Odds API (the-odds-api.com -> "Get API Key" -- free tier, 500 credits/mo,
# no card). Used by scripts/collect_odds.py for NFL game odds + futures capture;
# the archiver skips these sources gracefully when the key is absent.
ODDS_API_KEY=

# Optional: permissive teacher model for SFT distillation (see GAMEPLAN §7 note).
QWEN_API_KEY=
DEEPSEEK_API_KEY=
